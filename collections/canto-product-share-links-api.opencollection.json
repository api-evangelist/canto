              }
            ]
          },
          "docs": "    Get details of a specific share link.\n"
        },
        {
          "info": {
            "name": "Delete Product Share Link",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{tenantSubdomain}.{region}/api/v1/pim/product_share_links/:id",
