              "type": "json",
              "data": "{}"
            }
          },
          "docs": "    Generate a new share link for a product.\n"
        },
        {
          "info": {
            "name": "Get Product Share Link",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantSubdomain}.{region}/api/v1/pim/product_share_links/:id",
