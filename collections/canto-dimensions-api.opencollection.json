              "type": "json",
              "data": "{}"
            }
          },
          "docs": "    Create a new product dimension\n"
        },
        {
          "info": {
            "name": "Get Dimension",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{tenantSubdomain}.{region}/api/v1/pim/dimensions/:id",
