        {
          "info": {
            "name": "Update Dimension",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{tenantSubdomain}.{region}/api/v1/pim/dimensions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "    Update specific fields of an existing dimension\n"
        }
      ]
    }
