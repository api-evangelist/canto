      "id": "a0c46e2a-e838-43b4-baef-d1d3de70da55",
      "name": "import_settings",
      "description": {
        "content": "        API endpoints for configuring how CSV imports should be processed.\n        This includes:\n        - Mapping CSV headers to product attributes\n        - Configuring how product variations should be handled\n        - Setting up category and type assignments\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2d37f223-ee4a-4184-8d07-31ed7176db41",
          "name": "Configure import mappings and variation formats",
          "request": {
            "name": "Configure import mappings and variation formats",
            "description": {
              "content": "    Creates or retrieves channel template and format settings based on provided mappings.\n\n    This endpoint helps configure how CSV data will be imported by:\n    1. Mapping CSV headers to product attributes\n    2. Defining how variations should be grouped\n    3. Specifying dimension and option columns\n\n    Returns IDs needed for the actual import process.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "import_settings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": {
                    "content": "",
                    "type": "text/plain"
                  },
                  "type": "any",
                  "value": "{{tenantSubdomain}}",
                  "key": "tenantSubdomain"
                },
                {
                  "description": " (This can only be one of canto.com,canto.global,canto.de,au.canto.com,ca.canto.com)",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "*/*"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
