{
  "opencollection": "1.0.0",
  "info": {
    "name": "Canto PIM bulk_products_catalogs webhooks API",
    "version": "v1.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "webhooks",
        "type": "folder"
      },
      "items": [
