          "id": "138729c9-ba9c-49e8-bad9-00c21ffeea5e",
          "name": "Import products from CSV",
          "request": {
            "name": "Import products from CSV",
            "description": {
              "content": "        Creates a new product import job from a CSV file.\n\n        The CSV file should be uploaded as multipart form data along with\n        the channel template and channel format IDs for processing the import.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "imports"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": {
                    "content": "",
                    "type": "text/plain"
                  },
                  "type": "any",
                  "value": "{{tenantSubdomain}}",
                  "key": "tenantSubdomain"
                },
                {
                  "description": " (This can only be one of canto.com,canto.global,canto.de,au.canto.com,ca.canto.com)",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "channel_format_id",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Channel format ID that contains the variation format settings"
                },
                {
                  "key": "channel_template_id",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Channel template ID that contains the custom attribute mappings"
                },
                {
                  "key": "file",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) The CSV file to import (multipart form data)"
                },
                {
                  "key": "product_type_id",
                  "value": "<string>",
                  "type": "text",
                  "description": "Product type ID to assign to imported products"
                },
                {
                  "key": "product_category_id",
                  "value": "<string>",
                  "type": "text",
                  "description": "Product category ID to assign to imported products"
                },
                {
                  "key": "product_category_header",
                  "value": "<string>",
                  "type": "text",
                  "description": "Product category header in CSV to use to dynamically assign the product category (max 255 chars)"
                },
                {
                  "key": "product_category_id_header",
                  "value": "<string>",
                  "type": "text",
                  "description": "Product category ID header in CSV to use to dynamically assign the product category (max 255 chars)"
                }
              ]
            }
